# Copy to .env.local and fill in. .env.local is git-ignored.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/trial_advocacy_dev
# Optional locally; required in production (heroku config:set SESSION_SECRET=...)
SESSION_SECRET=
# Case file storage. Leave blank to keep files in a local .storage/ folder.
# Required in production; see docs/s3-setup.md.
S3_BUCKET=
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AI witnesses (Claude). Get a key at https://platform.claude.com; never commit it.
ANTHROPIC_API_KEY=
# Which Claude model the app uses for every AI step (default claude-haiku-5-5).
# Restart the server after changing it. Optional per step, overriding CLAUDE_MODEL:
# CLAUDE_WITNESS_MODEL, CLAUDE_INVESTIGATOR_MODEL, CLAUDE_SUBPOENA_MODEL, CLAUDE_MENTOR_MODEL, CLAUDE_TRANSCRIBE_MODEL, CLAUDE_REVIEW_MODEL, CLAUDE_EVAL_MODEL.
CLAUDE_MODEL=claude-haiku-5-5
